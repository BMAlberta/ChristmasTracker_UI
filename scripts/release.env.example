# scripts/release.env.example — copy to scripts/release.env and fill in real values.
# scripts/release.env is untracked (.gitignore). Never commit it.
# Never echo secret values; the script checks for presence and masks output.

# Apple Distribution team ID (required)
RELEASE_TEAM_ID=YOURTEAMID

# Ad hoc provisioning profile name as it appears in Xcode / Apple Developer portal (required)
RELEASE_PROFILE_NAME=YourAdHocProfileName

# App bundle identifier (default: com.alberta.ChristmasTracker)
RELEASE_BUNDLE_ID=com.alberta.ChristmasTracker

# S3 bucket name for IPA and manifest hosting (required)
RELEASE_S3_BUCKET=your-distribution-bucket

# S3 key prefix under the bucket (default: distribution/tracker)
RELEASE_S3_PREFIX=distribution/tracker

# Public HTTPS base URL served from the bucket (default: https://content.bmalberta.com)
RELEASE_PUBLIC_BASE_URL=https://content.bmalberta.com

# AWS CLI named profile to use for uploads (optional; omit to use the default profile)
# RELEASE_AWS_PROFILE=your-aws-profile

# Xcode export method (default: release-testing — Xcode's name for ad hoc)
RELEASE_EXPORT_METHOD=release-testing

# Minimum days before the provisioning profile expires to still allow a release (default: 14)
RELEASE_MIN_PROFILE_DAYS=14
